<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_calm" android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="暖月" android:textColor="@color/ink" android:textSize="12sp" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/widget_mascot" android:contentDescription="小月" />
    </LinearLayout>
    <TextView android:id="@+id/widget_headline"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:gravity="center_vertical" android:text="开始记录"
        android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink"
        android:includeFontPadding="true" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_detail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="点我记录第一次经期" android:textSize="11sp" android:textColor="@color/ink"
        android:maxLines="1" />
    <TextView android:id="@+id/widget_next_date"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="@color/ink"
        android:maxLines="1" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/widget_cycle_label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
        android:text="记录后显示周期进度" android:textSize="10sp" android:textColor="@color/ink"
        android:maxLines="1" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp"
        android:progressDrawable="@drawable/widget_progress" android:indeterminate="false" android:max="100" />
</LinearLayout>
