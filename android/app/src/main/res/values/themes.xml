<resources>
    <style name="Theme.NuanYue" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ny_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.NuanYue.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ny_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ny_rose_container</item>
        <item name="postSplashScreenTheme">@style/Theme.NuanYue</item>
    </style>
</resources>
